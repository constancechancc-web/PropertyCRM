# Postgres connection string. On Vercel this is filled in automatically when you
# connect a Postgres (Neon) database to the project. Leave empty locally to use the
# built-in local database in .data/pglite.
DATABASE_URL=

# Random secret for signing login cookies (at least 32 characters). Required on Vercel.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Local development only: password for the three dev users created in .data/pglite.
DEV_USER_PASSWORD=crm-local-dev
