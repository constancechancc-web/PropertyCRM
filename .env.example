# Postgres connection string. On Vercel this is filled in automatically when you
# connect a Postgres (Neon) database. On your computer it is only used by the
# `npm run db:*` and `npm run user:*` commands (npm run dev always uses .data/pglite).
DATABASE_URL=

# Random secret for signing login cookies (at least 32 characters). Required on Vercel.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

